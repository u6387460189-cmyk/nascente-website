# Set these in Vercel → Project → Settings → Environment Variables (never commit real values).

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (domain nascenteproject.com must be verified in Resend)
RESEND_API_KEY=

# Optional overrides
INQUIRY_TO=info@nascenteproject.com
INQUIRY_FROM=Nascente Project <inquiries@nascenteproject.com>
